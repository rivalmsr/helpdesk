# Test environment used by Playwright E2E. Copy to server/.env.test and fill in.
# DATABASE_URL MUST point at a dedicated test database, separate from dev — the
# global setup migrates and seeds it, and tests may mutate its data.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/helpdesk_test?schema=public"

# Seed credentials written into the test database by prisma/seed.ts.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="password123"
AGENT_EMAIL="agent@example.com"
AGENT_PASSWORD="password123"

# Shared secret for the inbound-email webhook (X-Webhook-Secret header).
INBOUND_EMAIL_SECRET="test-inbound-secret"
