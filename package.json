{
  "name": "helpdesk",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"bun --filter client dev\" \"bun --filter server dev\"",
    "dev:client": "bun --filter client dev",
    "dev:server": "bun --filter server dev",
    "build": "bun --filter client build && bun --filter server build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "concurrently": "^9.1.2",
    "dotenv": "^17.4.2"
  }
}
